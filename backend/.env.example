# Copie para .env e preencha: cp .env.example .env
PORT=3000
MONGO_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/internet_gratis?retryWrites=true&w=majority
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
# Chave AES-256 do cryptoService: 64 caracteres hex (gere com: openssl rand -hex 32)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Teto diário de créditos ganhos assistindo anúncios (por usuário)
ADS_DAILY_CAP=20
# Redes de anúncios reais (opcional — o app já vem com anúncios de exemplo)
ADSENSE_CLIENT_ID=
ADMOB_APP_ID=
# URL do frontend (para referência/CORS)
FRONTEND_URL=http://localhost:8080
# Para testar sem Atlas, descomente (usa Mongo em memória, dados voláteis):
# USE_MEMORY_DB=true
# (Sem MONGO_URI real ele já cai no modo memória sozinho.)
